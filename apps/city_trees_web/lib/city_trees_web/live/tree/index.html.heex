<.live_component 
  module={CityTreesWeb.DashboardLive.DashboardLayout} 
  id="dashboard_layout"
>
  <%= if @live_action in [:new, :edit] do %>
    <.modal return_to={Routes.tree_index_path(@socket, :index)}>
      <.live_component
        module={CityTreesWeb.TreeLive.TreeForm}
        id={@tree.id || :new}
        title={@page_title}
        action={@live_action}
        tree={@tree}
        return_to={Routes.tree_index_path(@socket, :index)}
      />
    </.modal>
  <% end %>


  <div class="px-4 sm:px-6 lg:px-8 w-full">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <h1 class="text-xl font-semibold text-gray-900">Trees</h1>
        <p class="mt-2 text-sm text-gray-700">A list of all trees</p>
      </div>
      <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
        <button type="button" class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto">
          <span><%= live_patch "New Tree", to: Routes.tree_index_path(@socket, :new) %></span>
        </button>
      </div>
    </div>
    <div class="mt-8 flex flex-col">
      <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle">
          <div class="overflow-hidden shadow-sm ring-1 ring-black ring-opacity-5">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6 lg:pl-8">Spiecies</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Diameter low</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Diameter high</th>
                  <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 lg:pr-8">
                    <span class="sr-only">Actions</span>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">

                <%= for tree <- @trees do %>
                  <tr id={"tree-#{tree.id}"}>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= tree.spiecies_id %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= tree.diameter_low %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= tree.diameter_high %>
                    </td>
            
                    <td>
                      <span><%= live_redirect "Show", to: Routes.tree_show_path(@socket, :show, tree) %></span>
                      <span><%= live_patch "Edit", to: Routes.tree_index_path(@socket, :edit, tree) %></span>
                      <span><%= link "Delete", to: "#", phx_click: "delete", phx_value_id: tree.id, data: [confirm: "Are you sure?"] %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</.live_component>














