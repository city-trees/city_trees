
<div class="h-full flex">
  
  <!-- Off-canvas menu for mobile -->
  <mobile-nav class="relative z-40 lg:hidden translate-x-0" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-600 bg-opacity-75"></div>

    <div class="fixed inset-0 flex z-40">
      <!-- ff-canvas menu, show/hide based on off-canvas menu state. -->
      <div class="relative flex-1 flex flex-col max-w-xs w-full bg-white focus:outline-none">
        <div class="absolute top-0 right-0 -mr-12 pt-2">
          <mobile-nav-close
            type="button" 
            class="ml-1 flex items-center justify-center h-10 w-10 rounded-full focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white opacity-0">
            <span class="sr-only">Close sidebar</span>
            <HeroiconOutline.x />
          </mobile-nav-close>
        </div>

        <.live_component module={CityTreesWeb.DashboardLive.Navigation} id="navigation_mobile"/>
        <.live_component module={CityTreesWeb.DashboardLive.ProfileNavigation} id="profile_navigation_mobile"/>
      </div>

      <!-- Force sidebar to shrink to fit close icon -->
      <div class="flex-shrink-0 w-14" aria-hidden="true"></div>
    </div>
  </mobile-nav>

  <!-- Static sidebar for desktop -->
  <div class="hidden lg:flex lg:flex-shrink-0">
    <div class="flex flex-col w-64">
      <div class="flex-1 flex flex-col border-r border-gray-200 bg-gray-100">
        <.live_component module={CityTreesWeb.DashboardLive.Navigation} id="navigation"/>
        <.live_component module={CityTreesWeb.DashboardLive.ProfileNavigation} id="profile_navigation"/>
      </div>
    </div>
  </div>

  <!-- Main area -->
  <div class="relative flex flex-col z-0 flex-1">
    <!-- Mobile header only visible on mobile -->
    <.live_component 
      module={CityTreesWeb.DashboardLive.MobileHeader} 
      id="mobile_header"
    />

    <!-- Main area of application -->
    <div class="relative overflow-auto columns-1 h-full w-full">
      <%= render_slot(@inner_block) %>
    </div>
  </div>
</div>

