<div class="flex-1 flex flex-col py-1.5 pb-4 overflow-y-auto">
  <div class="flex items-center flex-shrink-0 px-4">
    <BrandStyle.logo />
  </div>
  

  <nav class="mt-5 flex-1" aria-label="Sidebar">
    <div class="px-2 space-y-1">

      <%= for {title, icon, path, active} <- @left_nav do %>
        <%= live_patch to: path, class: (
            if active do 
              "bg-gray-200 text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md"
            else 
              "text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md"
            end)
          do %>
          <HeroiconOutline.render icon={icon} class="text-gray-400 group-hover:text-gray-500 mr-3 h-6 w-6" />
          <%= title %>
        <% end %>
      <% end %>
    </div>
  </nav>
</div>


