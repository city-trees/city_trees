<AuthLayout.layout title="Forgot your password?">

<.form let={f} for={:user} action={Routes.user_reset_password_path(@conn, :create)}>
  <TailwindForm.email_input form={f} />

  <div class="py-2">
    <TailwindButton.primary type="Send instructions to reset password" size={:medium}>Confirm my account</TailwindButton.primary>
  </div>
</.form>

<p>
  <%= link "Register", to: Routes.user_registration_path(@conn, :new) %> |
  <%= link "Log in", to: Routes.user_session_path(@conn, :new) %>
</p>
</AuthLayout.layout>