<AuthLayout.layout title="Resend confirmation instructions">
  <.form let={f} for={:user} class="space-y-4" action={Routes.user_confirmation_path(@conn, :create)}>
    <TailwindForm.email_input form={f} />

    <TailwindButton.primary type="submit" size={:medium}>Resend confirmation instructions</TailwindButton.primary>
  </.form>

  <p class="pt-2">
    <%= link "Register", to: Routes.user_registration_path(@conn, :new) %> |
    <%= link "Log in", to: Routes.user_session_path(@conn, :new) %>
  </p>
</AuthLayout.layout>