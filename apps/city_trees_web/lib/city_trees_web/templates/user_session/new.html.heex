<AuthLayout.layout title="Log in">

  <.form let={f} for={@conn} class="space-y-6" action={Routes.user_session_path(@conn, :create)} as={:user}>
    <%= if @error_message do %>
      <TailwindAlert.error message={@error_message} />
    <% end %>

    <TailwindForm.email_input form={f} />
    <TailwindForm.password_input form={f} />

    <%= label f, :remember_me, "Keep me logged in for 60 days" %>
    <%= checkbox f, :remember_me %>

    <div>
      <TailwindButton.primary type="submit" size={:medium}>Log in</TailwindButton.primary>
    </div>
  </.form>

  <p>
    <%= link "Register", to: Routes.user_registration_path(@conn, :new) %> |
    <%= link "Forgot your password?", to: Routes.user_reset_password_path(@conn, :new) %>
  </p>
</AuthLayout.layout>