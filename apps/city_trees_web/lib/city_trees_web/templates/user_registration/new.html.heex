
<AuthLayout.layout title="Create account">
  <.form let={f} for={@changeset}  class="space-y-6" action={Routes.user_registration_path(@conn, :create)}>
    <%= if @changeset.action do %>
      <div class="alert alert-danger">
        <p>Oops, something went wrong! Please check the errors below.</p>
      </div>
    <% end %>

    <TailwindForm.email_input form={f} />
    <TailwindForm.password_input form={f} />

    <div>
      <TailwindButton.primary type="submit" size={:medium}>Register</TailwindButton.primary>
    </div>
  </.form>
</AuthLayout.layout>