<div>
  <h2><%= @title %></h2>

  <.form
    let={f}
    for={@changeset}
    id="tree-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    class="space-y-4" 
  >

    <TailwindForm.number_input field={:species_id} form={f} label="Spiecies" />
    <TailwindForm.number_input field={:diameter_low} form={f} label="Diameter low" />
    <TailwindForm.number_input field={:diameter_high} form={f} label="Diameter high" />
    <TailwindForm.text_input field={:description} form={f} label="Description" />

    <geolocation-inputs>
      <TailwindForm.number_input slot="longitude" field={:longitude} form={f} label="Longitude" />
      <TailwindForm.number_input slot="latitude" field={:latitude} form={f} label="Latitude" />
    </geolocation-inputs>
    
    <TailwindButton.primary type="submit" size={:medium}>Save</TailwindButton.primary>  
  </.form>
</div>
