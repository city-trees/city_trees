            "filename": null,
            "id": "dd8cd3cebb39d6ac0eb6b3dc56cb109718061653b2cc68680e2aed6843fe8c27",
            "rendered": "#cloud-config\nusers:\n  - name: devops\n    groups: users, admin\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAS/7t75Vdf8383f9Qt61iJG1yXDXBzFJA6QS+8qeieo raziel@be-quiet-lin\n\npackage_update: true\npackage_upgrade: true\n  - ufw\n  - unzip\nruncmd:\n  # Enable firewall\n  - ufw enable\n\n  - apt-get update\n  - apt-get upgrade\n\n  - ufw allow 2211/tcp comment 'Open port ssh tcp port 2211'\n\n  # ssh hardening\n  # @see https://www.digitalocean.com/community/tutorials/how-to-harden-openssh-on-ubuntu-20-04\n  # @see https://kennethghartman.com/change-config-settings-using-a-bash-script/\n  - cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak\n  # Chnage ssh port to 2211\n  - sed -i 's/#\\?\\(Port\\s*\\).*$/\\1 2211/' /etc/ssh/sshd_config\n  # Disable root login over ssh\n  - sed -i 's/#\\?\\(PermitRootLogin\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Enable public key auth\n  - sed -i 's/#\\?\\(PubkeyAuthentication\\s*\\).*$/\\1 yes/' /etc/ssh/sshd_config\n  # Disable empty passwords\n  - sed -i 's/#\\?\\(PermitEmptyPasswords\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable password base auth \n  - sed -i 's/#\\?\\(PasswordAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Set max retries to 2\n  - sed -i 's/#\\?\\(MaxAuthTries\\s*\\).*$/\\1 3/' /etc/ssh/sshd_config\n  # Disable x11Forwarding\n  - sed -i 's/#\\?\\(X11Forwarding\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Do not show info about last login\n  - sed -i 's/#\\?\\(PrintLastLog\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable tunnel\n  - sed -i 's/#\\?\\(PermitTunnel\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable agent forwards\n  - sed -i 's/#\\?\\(AllowAgentForwarding\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable tcp forwards\n  - sed -i 's/#\\?\\(AllowTcpForwarding\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable ChallengeResponseAuthentication\n  - sed -i 's/#\\?\\(ChallengeResponseAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable KerberosAuthentication\n  - sed -i 's/#\\?\\(KerberosAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable GSSAPIAuthentication\n  - sed -i 's/#\\?\\(GSSAPIAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Only allow devops user\n  - sed -i '$a AllowUsers devops' /etc/ssh/sshd_config\n  - systemctl reload sshd.service\n\n  # Additional reboot to ensure that all is updated\n  - reboot",
            "template": "#cloud-config\nusers:\n  - name: devops\n    groups: users, admin\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    ssh_authorized_keys:\n      ${ssh_authorized_keys}\npackage_update: true\npackage_upgrade: true\n  - ufw\n  - unzip\nruncmd:\n  # Enable firewall\n  - ufw enable\n\n  - apt-get update\n  - apt-get upgrade\n\n  - ufw allow 2211/tcp comment 'Open port ssh tcp port 2211'\n\n  # ssh hardening\n  # @see https://www.digitalocean.com/community/tutorials/how-to-harden-openssh-on-ubuntu-20-04\n  # @see https://kennethghartman.com/change-config-settings-using-a-bash-script/\n  - cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak\n  # Chnage ssh port to 2211\n  - sed -i 's/#\\?\\(Port\\s*\\).*$/\\1 2211/' /etc/ssh/sshd_config\n  # Disable root login over ssh\n  - sed -i 's/#\\?\\(PermitRootLogin\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Enable public key auth\n  - sed -i 's/#\\?\\(PubkeyAuthentication\\s*\\).*$/\\1 yes/' /etc/ssh/sshd_config\n  # Disable empty passwords\n  - sed -i 's/#\\?\\(PermitEmptyPasswords\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable password base auth \n  - sed -i 's/#\\?\\(PasswordAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Set max retries to 2\n  - sed -i 's/#\\?\\(MaxAuthTries\\s*\\).*$/\\1 3/' /etc/ssh/sshd_config\n  # Disable x11Forwarding\n  - sed -i 's/#\\?\\(X11Forwarding\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Do not show info about last login\n  - sed -i 's/#\\?\\(PrintLastLog\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable tunnel\n  - sed -i 's/#\\?\\(PermitTunnel\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable agent forwards\n  - sed -i 's/#\\?\\(AllowAgentForwarding\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable tcp forwards\n  - sed -i 's/#\\?\\(AllowTcpForwarding\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable ChallengeResponseAuthentication\n  - sed -i 's/#\\?\\(ChallengeResponseAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable KerberosAuthentication\n  - sed -i 's/#\\?\\(KerberosAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Disable GSSAPIAuthentication\n  - sed -i 's/#\\?\\(GSSAPIAuthentication\\s*\\).*$/\\1 no/' /etc/ssh/sshd_config\n  # Only allow devops user\n  - sed -i '$a AllowUsers devops' /etc/ssh/sshd_config\n  - systemctl reload sshd.service\n\n  # Additional reboot to ensure that all is updated\n  - reboot",
